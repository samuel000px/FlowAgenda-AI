# Copie para .env e coloque a sua chave (https://aistudio.google.com/apikey).
# O .env fica fora do git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Google Agenda (opcional; ver docs/integracao-google-agenda.md) ---
# ID da agenda: em Configurações da agenda > Integrar agenda. "primary" é a agenda principal da conta.
GOOGLE_CALENDAR_ID=
# Arquivo JSON baixado do Google Cloud (OAuth "App para computador" ou conta de serviço).
# Guarde o arquivo na pasta credenciais/, que fica fora do git.
GOOGLE_CREDENTIALS_FILE=credenciais/google-credentials.json
# Onde o login OAuth fica salvo depois da primeira autorização (também fora do git).
GOOGLE_TOKEN_FILE=credenciais/google-token.json
